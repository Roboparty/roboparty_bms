#!/usr/bin/make -f

INSTALL_PREFIX ?= /opt/roboparty
export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=$(INSTALL_PREFIX) \
		-DCMAKE_PREFIX_PATH=$(INSTALL_PREFIX) \
		-DCMAKE_BUILD_TYPE=Release

override_dh_install:
	dh_install

	install -d debian/roboparty-bms/etc/default
	install -m 644 etc/default/bms_daemon.default debian/roboparty-bms/etc/default/bms_daemon

	install -d debian/roboparty-bms/etc/systemd/system
	install -m 644 etc/systemd/system/*.service debian/roboparty-bms/etc/systemd/system/

	install -d debian/roboparty-bms$(INSTALL_PREFIX)/bin
	install -m 755 scripts/bms_ota.py debian/roboparty-bms$(INSTALL_PREFIX)/bin/

	install -d debian/roboparty-bms$(INSTALL_PREFIX)/lib/firmware
	install -m 644 firmware/*.bin debian/roboparty-bms$(INSTALL_PREFIX)/lib/firmware/

override_dh_installdeb:
	dh_installdeb
	sed -i 's|@INSTALL_PREFIX@|$(INSTALL_PREFIX)|g' \
		debian/roboparty-bms/DEBIAN/postinst
