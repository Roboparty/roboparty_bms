[Unit]
Description=BMS Heartbeat Daemon
After=network.target

[Service]
EnvironmentFile=/etc/default/bms_daemon
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/bms_daemon ${BMS_PORT} ${BAUD_RATE} ${TIMEOUT_MS} ${BMS_TYPE} ${BMS_ADDR}
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
