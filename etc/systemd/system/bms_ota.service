[Unit]
Description=BMS Firmware OTA Update Task
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/bms_daemon
ExecStartPre=/bin/systemctl stop bms.service
# BMS_TYPE picks the protocol tool: TWS -> bms_ota.py, SCUD485 -> scud_ota.py
ExecStart=/usr/bin/bms_ota_dispatch ${BMS_TYPE}
ExecStopPost=/bin/systemctl start bms.service
RemainAfterExit=no
User=root

[Install]
WantedBy=multi-user.target
