[Unit]
Description=BMS Firmware OTA Update Task
After=network.target

[Service]
Type=oneshot
ExecStartPre=/bin/systemctl stop bms.service
# Default OTA firmware path is derived from the install prefix by bms_ota.py.
ExecStart=/usr/bin/python3 /usr/bin/bms_ota.py /etc/default/bms_daemon
ExecStopPost=/bin/systemctl start bms.service
RemainAfterExit=no
User=root

[Install]
WantedBy=multi-user.target
